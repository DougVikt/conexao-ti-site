// Configuração local da Conexão TI
// 1. Copie este arquivo para config.js
// 2. Preencha a apiKey com sua chave do Google Cloud (Drive API v3 habilitada)
// 3. NÃO commit o config.js — ele já está no .gitignore
//
// Na Vercel, o config.js é gerado automaticamente por scripts/generate-config.js
// a partir da variável de ambiente GOOGLE_DRIVE_API_KEY.

window.CONEXAO_CONFIG = {
    drive: {
        // Chave da API restrita ao domínio do site (Google Cloud → Credenciais)
        apiKey: 'COLE_SUA_GOOGLE_DRIVE_API_KEY_AQUI',

        // ID da pasta raiz da Biblioteca Coletiva no Drive
        // Ex.: https://drive.google.com/drive/folders/1N5kTne7aYPXn-N57nHIgYAUfW1V-5Uzx
        parentFolderId: '1N5kTne7aYPXn-N57nHIgYAUfW1V-5Uzx'
    }
};
